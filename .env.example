# TracePilot Environment Configuration Template
# Copy this file to .env and fill in required values for your environment.

# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/tracepilot?schema=public"

# Ingestion API Key for SDK / Demo
TRACEPILOT_API_KEY="tp_dev_example_placeholder_key"
TRACEPILOT_ENDPOINT="http://localhost:4000"

# Development Auth Controls (Bypasses auth only in non-production environments)
PAUSE_AUTH="false"
DISABLE_AUTH="false"

# AI Provider Configurations (Configure at least one for diagnosis)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Qdrant Vector Database
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="tracepilot_evidence"

# Hugging Face Router
HUGGINGFACE_API_KEY=""
HF_TOKEN=""
HF_MODEL="deepseek-ai/DeepSeek-V4.1-Flash-1017:novita"
HF_ROUTER_URL="https://router.huggingface.co/v1"

# OpenRouter (v2.2 Provider Contract)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# OpenRouter Nemotron 3.5 Embed 8B & RAG Defaults (v2.2)
EMBEDDING_PROVIDER="openrouter"
OPENROUTER_EMBEDDING_MODEL="nvidia/nemotron-3.5-embed-8b:free"
EMBEDDING_DIMENSIONS=1024
QDRANT_DISTANCE="Cosine"
QDRANT_CODE_COLLECTION="tracepilot_code_v2"
QDRANT_INCIDENT_COLLECTION="tracepilot_incidents_v2"
RAG_SEMANTIC_TOP_K=30
RAG_LEXICAL_TOP_K=30
RAG_FINAL_TOP_K=5
RAG_HYBRID_SEARCH_ENABLED="true"
RAG_HISTORICAL_RETRIEVAL_ENABLED="true"

# Crawl4AI Cloud Engine (Website Scanner)
CRAWL4AI_API_KEY=""
CRAWL4AI_BASE_URL="https://api.crawl4ai.com"
